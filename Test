    // ---------- TEST 1 : getMerchantUsers ----------
    @Test
    void testGetMerchantUsers_Success() {
        // Mock user principal
        MerchantUserDto loggedInUser = new MerchantUserDto();
        loggedInUser.setUsername("testUser");
        loggedInUser.setRole("ROLE_ADMIN");

        // Mock static method EPayIdentityUtil.getUserPrincipal()
        try (MockedStatic<EPayIdentityUtil> mockedUtil = mockStatic(EPayIdentityUtil.class)) {
            mockedUtil.when(() -> EPayIdentityUtil.getUserPrincipal())
                    .thenReturn(() -> "testUser"); // Mock principal

            // Mock getByUserName (indirect call)
            MerchantUserDto merchantUserDto = new MerchantUserDto();
            merchantUserDto.setUsername("testUser");
            merchantUserDto.setRole("ROLE_ADMIN");
            merchantUserDto.setRoleName("Admin Role");

            // Mock repository + mapper
            MerchantUser entity = new MerchantUser();
            List<MerchantUser> entityList = List.of(entity);
            List<MerchantUserDto> dtoList = List.of(new MerchantUserDto());

            when(merchantUserRepository.findAll(any(Specification.class), any(Sort.class)))
                    .thenReturn(entityList);
            when(merchantMapper.mapMerchantUserEntityListToDtoList(entityList))
                    .thenReturn(dtoList);

            // Call method
            List<MerchantUserDto> result = merchantUserDao.getMerchantUsers(new MerchantUserSearchRequest(), List.of(UUID.randomUUID()));

            // Verify
            assertNotNull(result);
            assertEquals(1, result.size());
            verify(merchantUserRepository, times(1)).findAll(any(Specification.class), any(Sort.class));
            verify(merchantMapper, times(1)).mapMerchantUserEntityListToDtoList(entityList);
        }
    }

    // ---------- TEST 2 : getMappedUserIdsByMid ----------
    @Test
    void testGetMappedUserIdsByMid_Success() {
        String mId = "MID123";
        UUID user1 = UUID.randomUUID();
        UUID user2 = UUID.randomUUID();

        when(merchantEntityUserRepository.findUserIdsByMId(mId))
                .thenReturn(new ArrayList<>(List.of(user1)));
        when(merchantEntityGroupRepository.getAllUserIdByMId(mId))
                .thenReturn(new ArrayList<>(List.of(user2)));

        List<UUID> result = merchantUserDao.getMappedUserIdsByMid(mId);

        assertNotNull(result);
        assertEquals(2, result.size());
        assertTrue(result.contains(user1));
        assertTrue(result.contains(user2));

        verify(merchantEntityUserRepository, times(1)).findUserIdsByMId(mId);
        verify(merchantEntityGroupRepository, times(1)).getAllUserIdByMId(mId);
    }
}
