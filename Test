public List<MerchantUserDto> getMerchantUsers(MerchantUserSearchRequest merchantUserSearchRequest, List<UUID> mappedUserIds) {
        String username = EPayIdentityUtil.getUserPrincipal().getUsername();
        MerchantUserDto merchantUser = getByUserName(username, UserStatus.ACTIVE);
        merchantUser.setRoleName(getRoleNameByRoleId(merchantUser.getRole()));
        Specification<MerchantUser> specification = MerchantUserSpecification.searchUsers(merchantUser, merchantUserSearchRequest, mappedUserIds);
        List<MerchantUser> merchantUsers = merchantUserRepository.findAll(specification, Sort.by(Sort.Direction.DESC, "createdAt"));
        return merchantMapper.mapMerchantUserEntityListToDtoList(merchantUsers);
    }

    /**
     * Retrieves all merchant user ids which all mapped with given mId
     * @return List of UUID
     */
    public List<UUID> getMappedUserIdsByMid(String mId) {
        List<UUID> userIds = merchantEntityUserRepository.findUserIdsByMId(mId);
        userIds.addAll(merchantEntityGroupRepository.getAllUserIdByMId(mId));
        return userIds;
    }
